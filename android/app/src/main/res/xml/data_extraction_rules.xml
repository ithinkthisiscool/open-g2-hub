<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of this app goes to Google's cloud backup or to a new phone by device
     transfer. The saved settings hold private calendar links, and the AI keys in the Android
     Keystore cannot be restored on another device (the copied encrypted values would be
     unreadable). Users move settings with Settings > Privacy & backup instead (no secrets). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
